							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_process_table",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"run_date": {
										"value": "@pipeline().parameters.run_date",
										"type": "Expression"
									},
									"run_id": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									},
									"source_container": {
										"value": "@item().source_container",
										"type": "Expression"
									},
									"source_folder": {
										"value": "@item().source_folder",
										"type": "Expression"
									},
									"raw_container": {
										"value": "@item().raw_container",
										"type": "Expression"
									},
